#!/usr/bin/env python3
"""Deletes every index in the service.

Meilisearch does its writing in tasks it runs one after another, so the tasks
still waiting are canceled first, as a document addition queued behind the
deletes would make its index again. The deletes are tasks too, and are waited
for, so the service is empty by the time this returns rather than some time
after. The keys an app authenticates with are kept, since only the indexes are
deleted rather than the data directory they live in beside them.
"""
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOST = os.environ.get("MEILISEARCH_HOST", "127.0.0.1")
PORT = os.environ.get("MEILISEARCH_PORT", "7700")
MASTER_KEY = os.environ["MEILISEARCH_MASTER_KEY"]
TIMEOUT_SECONDS = int(os.environ.get("MEILISEARCH_TASK_TIMEOUT_SECONDS", "300"))
PAGE_SIZE = 100


def request(path, method="GET"):
    url = "http://{}:{}/{}".format(HOST, PORT, path)
    headers = {"Authorization": "Bearer " + MASTER_KEY}
    message = urllib.request.Request(url, headers=headers, method=method)

    with urllib.request.urlopen(message) as response:
        return json.load(response)


def wait(task_uid):
    deadline = time.monotonic() + TIMEOUT_SECONDS
    while True:
        task = request("tasks/{}".format(task_uid))
        status = task.get("status")
        if status == "succeeded":
            return True
        if status in ("failed", "canceled"):
            sys.stderr.write("task {} {}: {}\n".format(task_uid, status, task.get("error")))
            return False
        if time.monotonic() > deadline:
            sys.stderr.write("task {} did not finish within {}s\n".format(task_uid, TIMEOUT_SECONDS))
            return False
        time.sleep(0.5)


def indexes():
    uids = []
    offset = 0
    while True:
        page = request("indexes?offset={}&limit={}".format(offset, PAGE_SIZE))
        results = page.get("results", [])
        uids.extend(index["uid"] for index in results)
        offset += len(results)
        if not results or offset >= page.get("total", 0):
            return uids


def main():
    canceled = request("tasks/cancel?statuses=enqueued,processing", method="POST")
    if not wait(canceled["taskUid"]):
        return 1

    tasks = []
    for uid in indexes():
        try:
            deleted = request("indexes/{}".format(urllib.parse.quote(uid, safe="")), method="DELETE")
        except urllib.error.HTTPError as error:
            sys.stderr.write("unable to remove {}: {}\n".format(uid, error.read().decode()))
            return 1
        tasks.append(deleted["taskUid"])

    for task_uid in tasks:
        if not wait(task_uid):
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
